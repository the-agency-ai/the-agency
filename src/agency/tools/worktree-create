#!/bin/bash
#
# worktree-create — Create a git worktree for parallel agent sessions
#
# Usage:
#   worktree-create <name> [--branch <branch>]
#   worktree-create --workstream <ws> --agent <ag> [--branch <branch>]
#   worktree-create --compute-only --workstream <ws> --agent <ag>
#
# Creates a worktree at .claude/worktrees/<name>/ on branch <name> (or --branch).
# Aligns with Claude Code's built-in EnterWorktree convention.
# Sets up dev environment if dependencies are detected.
#
# Naming convention (per dispatch #166/#169): when `--workstream` and `--agent`
# are both provided, the worktree name is computed via the collapse rule:
#
#   if agent == workstream OR agent.startswith("workstream-"):
#       name = agent               # devex+devex → devex, mdpal+mdpal-app → mdpal-app
#   else:
#       name = "workstream-agent"  # agency+captain → agency-captain
#
# The positional form is preserved for backward compat and ad-hoc worktrees
# that don't belong to a workstream (e.g., fix branches, experiments).
#
# The `--compute-only` mode prints the computed name and exits without
# creating anything — useful for tests and programmatic callers that want
# to know the canonical name for a {workstream, agent} pair.
#
# Branch resolution is DWIM (v2.2.0). Given a branch name, the tool prefers,
# in order: an existing local branch, then an existing `origin/<branch>`
# (checked out as a local tracking branch), and only creates a brand-new
# branch from HEAD when neither exists. The origin/ case matters for reviving
# stale PRs whose branch was never fetched into a local ref — before v2.2.0
# those silently produced an empty branch from HEAD instead of the PR content.
#
# This is a FIRST-CLASS PRIMITIVE in Agency 2.0 — worktree isolation
# enables multiple agent sessions to work in parallel without conflicts.

set -euo pipefail

VERSION="2.2.0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Capture a caller-supplied project root BEFORE sourcing the helpers.
# lib/_path-resolve re-derives AGENCY_PROJECT_ROOT from this script's own
# location on source, unconditionally overwriting whatever the caller set.
# Without this capture the `${AGENCY_PROJECT_ROOT:-...}` default below is dead
# code, and a caller that points the tool at another checkout (tests, adopter
# scripts) silently gets a worktree in the WRONG repo.
CALLER_PROJECT_ROOT="${AGENCY_PROJECT_ROOT:-}"

# Source helpers
if [[ -f "$SCRIPT_DIR/lib/_log-helper" ]]; then
    source "$SCRIPT_DIR/lib/_log-helper"
fi
if [[ -f "$SCRIPT_DIR/lib/_path-resolve" ]]; then
    source "$SCRIPT_DIR/lib/_path-resolve"
fi

# --- Name computation (per #166/#169) ---
# compute_worktree_name <workstream> <agent>
#
# Implements the collapse rule: if the agent name is the workstream or starts
# with "workstream-", drop the workstream prefix; otherwise join with "-".
# Prints the computed name to stdout. Exits 1 on invalid input.
compute_worktree_name() {
    local ws="$1"
    local ag="$2"

    if [[ -z "$ws" ]] || [[ -z "$ag" ]]; then
        echo "compute_worktree_name: workstream and agent both required" >&2
        return 1
    fi

    if [[ "$ag" == "$ws" ]] || [[ "$ag" == "${ws}-"* ]]; then
        echo "$ag"
    else
        echo "${ws}-${ag}"
    fi
}

# _require_value <flag> [next ...]
#
# Guard for option parsing: under `set -u` a trailing flag with no argument
# ("worktree-create foo --branch") expands "$2" unbound and dies with a raw
# bash error instead of a usage hint. Call with the remaining "$@".
_require_value() {
    if [[ $# -lt 2 ]]; then
        echo "Error: $1 requires a value" >&2
        exit 1
    fi
}

# --- Flags ---
show_help() {
    cat <<HELP
Usage:
  worktree-create <name> [--branch <branch>]
  worktree-create --workstream <ws> --agent <ag> [--branch <branch>]
  worktree-create --compute-only --workstream <ws> --agent <ag>

Creates a git worktree at .claude/worktrees/<name>/

Options:
  --workstream <ws> Workstream name (pairs with --agent to compute name)
  --agent <ag>      Agent name (pairs with --workstream to compute name)
  --branch <name>   Branch name (default: same as worktree name)
  --compute-only    Print the computed name and exit (no worktree creation)
  --version         Show version
  --help            Show this help

Naming rule when both --workstream and --agent are given:
  agent == workstream OR agent starts with "workstream-"  → worktree = agent
  otherwise                                                → worktree = workstream-agent

Branch resolution (first match wins):
  local branch <branch> exists      → check it out
  <remote>/<branch> exists          → new local branch tracking it (origin wins
                                      if several remotes carry the branch)
  neither exists                    → new branch from current HEAD

Remote-tracking refs are only as fresh as your last fetch — fetch before
reviving a stale PR branch, or you will get an out-of-date worktree. The tool
prints the resolved commit and its distance from HEAD so you can tell.

Examples:
  worktree-create --workstream devex --agent devex       → devex
  worktree-create --workstream mdpal --agent mdpal-app   → mdpal-app
  worktree-create --workstream agency --agent captain    → agency-captain
HELP
}

# Short-circuit: --compute-only mode is pure naming logic, used by tests and
# programmatic callers that want the canonical name without side effects.
if [[ "${1:-}" == "--compute-only" ]]; then
    shift
    _ws=""
    _ag=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --workstream) _require_value "$@"; _ws="$2"; shift 2 ;;
            --agent) _require_value "$@"; _ag="$2"; shift 2 ;;
            *) echo "Unknown option: $1" >&2; exit 1 ;;
        esac
    done
    compute_worktree_name "$_ws" "$_ag"
    exit $?
fi

NAME=""
BRANCH=""
WORKSTREAM=""
AGENT=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --version|-v) echo "worktree-create $VERSION"; exit 0 ;;
        --help|-h) show_help; exit 0 ;;
        --branch) _require_value "$@"; BRANCH="$2"; shift 2 ;;
        --workstream) _require_value "$@"; WORKSTREAM="$2"; shift 2 ;;
        --agent) _require_value "$@"; AGENT="$2"; shift 2 ;;
        -*) echo "Unknown option: $1" >&2; exit 1 ;;
        *) NAME="$1"; shift ;;
    esac
done

# If --workstream and --agent were given, compute NAME via the collapse rule.
# Error if only one is given (ambiguous) or if positional name also given.
if [[ -n "$WORKSTREAM" ]] || [[ -n "$AGENT" ]]; then
    if [[ -z "$WORKSTREAM" ]] || [[ -z "$AGENT" ]]; then
        echo "Error: --workstream and --agent must be given together" >&2
        exit 1
    fi
    if [[ -n "$NAME" ]]; then
        echo "Error: cannot mix positional name with --workstream/--agent" >&2
        exit 1
    fi
    NAME="$(compute_worktree_name "$WORKSTREAM" "$AGENT")"
fi

if [[ -z "$NAME" ]]; then
    echo "Error: worktree name is required" >&2
    show_help >&2
    exit 1
fi

# Validate name
if ! [[ "$NAME" =~ ^[a-zA-Z][a-zA-Z0-9_-]*$ ]]; then
    echo "Error: name must start with a letter and contain only letters, numbers, hyphens, dashes" >&2
    exit 1
fi

BRANCH="${BRANCH:-$NAME}"

# NAME is regex-restricted above because it becomes a path component. BRANCH is
# NOT — branch names legitimately contain slashes (fix/foo, the usual PR shape).
# But it still has to be a legal git branch name, or `worktree add -b` fails
# with a raw plumbing error. `--branch HEAD` is the easy way to hit this: it
# matches refs/remotes/origin/HEAD, which exists in every clone.
if ! git check-ref-format --branch "$BRANCH" >/dev/null 2>&1; then
    echo "Error: '$BRANCH' is not a valid git branch name" >&2
    exit 1
fi

PROJECT_ROOT="${CALLER_PROJECT_ROOT:-${AGENCY_PROJECT_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}}"
WORKTREE_DIR="$PROJECT_ROOT/.claude/worktrees/$NAME"

# Check if worktree already exists
if [[ -d "$WORKTREE_DIR" ]]; then
    echo "Error: worktree '$NAME' already exists at $WORKTREE_DIR" >&2
    exit 1
fi

# Create worktree
echo "Creating worktree: $NAME"
echo "  Branch: $BRANCH"
echo "  Path: .claude/worktrees/$NAME/"

mkdir -p "$PROJECT_ROOT/.claude/worktrees"

# find_remote_for_branch <branch>
#
# Print the name of the remote whose tracking ref carries <branch>, or nothing.
# `origin` wins when several remotes carry the same branch; when several do and
# none is `origin`, that is genuinely ambiguous and we refuse rather than guess.
#
# Enumerating `git remote` and probing each with show-ref (rather than globbing
# refs/remotes/*/<branch>) keeps this correct for slash-bearing branch names,
# where a single `*` would otherwise have to span path components.
find_remote_for_branch() {
    local branch="$1"
    local r found="" matches=""
    while IFS= read -r r; do
        [[ -z "$r" ]] && continue
        if git -C "$PROJECT_ROOT" show-ref --verify --quiet "refs/remotes/$r/$branch" 2>/dev/null; then
            matches="$matches $r"
            if [[ "$r" == "origin" ]]; then
                found="origin"
            elif [[ -z "$found" ]]; then
                found="$r"
            fi
        fi
    done <<< "$(git -C "$PROJECT_ROOT" remote 2>/dev/null || true)"

    # More than one candidate and no origin to break the tie — refuse.
    # Returns nonzero rather than exiting: this runs inside a command
    # substitution, where `exit` would only kill the subshell and leave the
    # caller to carry on with an empty result.
    if [[ -n "$found" ]] && [[ "$found" != "origin" ]] && [[ $(echo $matches | wc -w) -gt 1 ]]; then
        echo "Error: branch '$branch' exists on multiple remotes ($matches)." >&2
        echo "       Refusing to guess. Create the local branch yourself, then re-run." >&2
        return 1
    fi

    echo "$found"
}

# Create branch + worktree.
#
# Three cases, checked in order (see also the DWIM note in the header):
#   1. Local branch exists            → check it out in the new worktree
#   2. Only <remote>/<branch> exists  → create a local tracking branch from it
#   3. Neither exists                 → create a brand-new branch from HEAD
#
# Case 2 is the stale-PR-revival path. Without it, asking for a worktree on a
# branch that lives only on a remote silently fell through to case 3 and created
# an EMPTY branch from HEAD — losing the PR's actual content. See the header
# note; this bit the revival of PR #426.
#
# Case 2 deliberately applies even when --branch was not passed (i.e. when the
# branch name defaulted to the worktree name). Creating a fresh local branch
# that shadows an existing remote branch of the same name is the very failure
# this tool now exists to prevent: the agent gets an empty tree and their first
# push is a non-fast-forward against their own real work. The tracking-vs-fresh
# choice is reported loudly below so a stale checkout is never silent.
REMOTE=""
if ! git -C "$PROJECT_ROOT" show-ref --verify --quiet "refs/heads/$BRANCH" 2>/dev/null; then
    # `if !` keeps set -e from firing so the ambiguous-remote message survives.
    if ! REMOTE="$(find_remote_for_branch "$BRANCH")"; then
        exit 1
    fi
fi

if git -C "$PROJECT_ROOT" show-ref --verify --quiet "refs/heads/$BRANCH" 2>/dev/null; then
    # Local branch exists — use it
    git -C "$PROJECT_ROOT" worktree add "$WORKTREE_DIR" "$BRANCH"
elif [[ -n "$REMOTE" ]]; then
    # Remote-only branch — create a local branch tracking <remote>/<branch>.
    # Report what is actually being checked out: a remote-tracking ref is only
    # as fresh as the last fetch, and a months-stale branch looks identical to
    # a current one unless we say so.
    echo "  Branch exists on '$REMOTE' only — tracking $REMOTE/$BRANCH"
    echo "    commit: $(git -C "$PROJECT_ROOT" log -1 --format='%h %cs %s' "$REMOTE/$BRANCH" 2>/dev/null || echo unknown)"
    echo "    vs HEAD: $(git -C "$PROJECT_ROOT" rev-list --count "HEAD..$REMOTE/$BRANCH" 2>/dev/null || echo '?') ahead, $(git -C "$PROJECT_ROOT" rev-list --count "$REMOTE/$BRANCH..HEAD" 2>/dev/null || echo '?') behind"
    echo "    (remote-tracking refs are only as fresh as your last fetch)"
    git -C "$PROJECT_ROOT" worktree add --track -b "$BRANCH" "$WORKTREE_DIR" "$REMOTE/$BRANCH"
else
    # Create new branch from HEAD. If the caller expected to land on an
    # existing remote branch, an un-fetched remote is the usual reason.
    echo "  No local or remote branch '$BRANCH' — creating it fresh from HEAD"
    echo "    (if you expected an existing remote branch, fetch first)"
    git -C "$PROJECT_ROOT" worktree add -b "$BRANCH" "$WORKTREE_DIR"
fi

# Install dependencies if detected
if [[ -f "$WORKTREE_DIR/package.json" ]]; then
    echo "Installing dependencies..."
    if [[ -f "$WORKTREE_DIR/pnpm-lock.yaml" ]]; then
        (cd "$WORKTREE_DIR" && pnpm install --frozen-lockfile 2>/dev/null) || true
    elif [[ -f "$WORKTREE_DIR/bun.lockb" ]] || [[ -f "$WORKTREE_DIR/bun.lock" ]]; then
        (cd "$WORKTREE_DIR" && bun install 2>/dev/null) || true
    elif [[ -f "$WORKTREE_DIR/yarn.lock" ]]; then
        (cd "$WORKTREE_DIR" && yarn install --frozen-lockfile 2>/dev/null) || true
    elif [[ -f "$WORKTREE_DIR/package-lock.json" ]]; then
        (cd "$WORKTREE_DIR" && npm ci 2>/dev/null) || true
    fi
fi

echo ""
echo "Worktree '$NAME' created successfully!"
echo ""
echo "To work in it:"
echo "  cd $WORKTREE_DIR && claude"
