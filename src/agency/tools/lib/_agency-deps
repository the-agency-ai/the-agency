# What Problem: Framework dependencies (jq, sqlite3, gh, bats, etc.) are listed
# in dependencies.yaml but there's no tool to check or install them. Fresh
# adopters get cryptic failures when tools are missing.
#
# How & Why: Reads dependencies.yaml and checks each binary. On macOS, uses
# brew to install missing ones; on Linux and WSL, apt (dnf/pacman get the
# command printed). Reports status in a clear table, including tools that are
# present but below min_version — on Ubuntu LTS that is the usual failure
# (sqlite3 3.37, python 3.10/3.12), and lib/_linux-floors raises those two
# without touching distro-owned binaries.
#
# Usage: agency deps [check|install]
#   check   — verify all deps, report missing and too-old (default)
#   install — install missing deps (brew on macOS, apt on Linux/WSL)
#
# Exit code: number of missing + too-old dependencies (0 = satisfied).
#
# Written: 2026-04-16 during D43 session (issue #135)
#
# Inherits: set -euo pipefail, AGENCY_DIR, _log-helper, colors

# --- Subcommand parsing ---
DEPS_CMD="${AGENCY_ARGS[0]:-check}"
DEPS_TIER="${AGENCY_ARGS[1]:-all}"  # all, required, testing, optional

_deps_help() {
    cat << 'HELP'
agency deps — Dependency management

Usage:
  agency deps              Check all dependencies (default)
  agency deps check        Same as above
  agency deps install      Install missing dependencies (brew on macOS, apt on Linux/WSL)
  agency deps install required   Install only required tier
  agency deps install testing    Install only testing tier

Reads: agency/config/dependencies.yaml
HELP
}

case "$DEPS_CMD" in
    --help|-h) _deps_help; exit 0 ;;
    check|install) ;;
    *) echo "Unknown deps command: $DEPS_CMD" >&2; _deps_help >&2; exit 1 ;;
esac

# --- Locate dependencies.yaml ---
PROJECT_ROOT="$(cd "$AGENCY_DIR/.." && pwd)"
DEPS_FILE="$PROJECT_ROOT/agency/config/dependencies.yaml"

if [[ ! -f "$DEPS_FILE" ]]; then
    echo "Error: dependencies.yaml not found at $DEPS_FILE" >&2
    exit 1
fi

# --- Platform ---

# shellcheck source=/dev/null
source "$AGENCY_DIR/tools/lib/_platform"
DEPS_PLATFORM="$(agency_platform)"          # darwin | wsl | linux | unknown
case "$DEPS_PLATFORM" in
    wsl|linux) DEPS_OS="linux" ;;
    *)         DEPS_OS="$DEPS_PLATFORM" ;;
esac

# --- Parse dependencies.yaml (awk-based, no yq/python dependency) ---
# Emits one line per entry: name|brew|apt|bin|bin_linux|min|optional_on|floor_linux
# ("-" for an absent field, so `read` never collapses empty columns).

_parse_tier() {
    local tier="$1"
    awk -v tier="$tier:" '
        function val(line,   v) {
            v = line
            sub(/^[^:]*:[ \t]*/, "", v)
            if (v ~ /^"/) { sub(/^"/, "", v); sub(/".*$/, "", v) }
            else          { sub(/[ \t]+#.*$/, "", v); gsub(/\047/, "", v) }
            sub(/[ \t]+$/, "", v)
            if (v == "" || v == "null") v = "-"
            return v
        }
        function flush() {
            if (current != "")
                print current "|" f["brew"] "|" f["apt"] "|" f["bin"] "|" f["bin_linux"] "|" f["min_version"] "|" f["optional_on"] "|" f["floor_linux"]
            current = ""
        }
        function reset() {
            f["brew"] = f["apt"] = f["bin"] = f["bin_linux"] = "-"
            f["min_version"] = f["optional_on"] = f["floor_linux"] = "-"
        }
        BEGIN { in_tier = 0; current = ""; reset() }
        /^[a-z]/ { flush(); in_tier = ($0 == tier) ? 1 : 0; next }
        !in_tier { next }
        /^  [A-Za-z0-9_-]+:[ \t]*$/ {
            flush(); reset()
            current = $0; gsub(/^  /, "", current); gsub(/:.*/, "", current)
            next
        }
        current != "" && /^    (brew|apt|bin|bin_linux|min_version|optional_on|floor_linux):/ {
            key = $0; sub(/^    /, "", key); sub(/:.*/, "", key)
            f[key] = val($0)
        }
        END { flush() }
    ' "$DEPS_FILE"
}

# --- Check dependencies ---

MISSING_PKGS=()      # packages installable by the platform package manager
MISSING_MANUAL=()    # no package — see install / install_linux in the yaml
FLOORS=()            # "sqlite:3.38" / "python:3.13" — raised by _linux-floors
FOUND=0
MISSING=0
OUTDATED=0
SKIPPED=0
TOTAL=0

_check_tier() {
    local tier="$1"
    local tier_label="$2"

    local entries
    entries=$(_parse_tier "$tier")
    if [[ -z "$entries" ]]; then
        return
    fi

    echo ""
    echo -e "${BLUE}$tier_label${NC}"
    echo "────────────────────────────────────────"

    local name brew apt bin bin_linux min optional_on floor
    while IFS='|' read -r name brew apt bin bin_linux min optional_on floor; do
        TOTAL=$((TOTAL + 1))

        # Which binary proves the dependency is present on this platform?
        local probe="$name"
        [[ "$bin" != "-" ]] && probe="$bin"
        [[ "$DEPS_OS" == "linux" && "$bin_linux" != "-" ]] && probe="$bin_linux"

        # Which package would install it here?
        local pkg="-" mgr="brew"
        if [[ "$DEPS_OS" == "linux" ]]; then mgr="apt"; pkg="$apt"; else pkg="$brew"; fi

        local path="" ver=""
        if [[ "$DEPS_OS" == "linux" && "$floor" == "python" && "$min" != "-" ]]; then
            # The distro owns `python3`; any python >= min on PATH satisfies it.
            path=$(agency_find_python "$min" 2>/dev/null) || path=$(command -v "$probe" 2>/dev/null) || path=""
        else
            path=$(command -v "$probe" 2>/dev/null) || path=""
        fi

        if [[ -z "$path" ]]; then
            if [[ "$optional_on" == "$DEPS_OS" || "$optional_on" == "$DEPS_PLATFORM" ]]; then
                printf "  ${YELLOW}–${NC} %-20s %s\n" "$name" "(not needed on $DEPS_PLATFORM)"
                SKIPPED=$((SKIPPED + 1))
                continue
            fi
            MISSING=$((MISSING + 1))
            if [[ "$DEPS_OS" == "linux" && "$floor" != "-" ]]; then
                printf "  ${RED}✗${NC} %-20s %s\n" "$name" "(missing — needs >= $min)"
                FLOORS+=("$floor:$min")
            elif [[ "$pkg" == "-" ]]; then
                printf "  ${RED}✗${NC} %-20s %s\n" "$name" "(missing — manual install)"
                MISSING_MANUAL+=("$name")
            else
                printf "  ${RED}✗${NC} %-20s %s\n" "$name" "(missing — $mgr: $pkg)"
                MISSING_PKGS+=("$pkg")
            fi
            continue
        fi

        ver=$(agency_tool_version "$path" 2>/dev/null) || ver=""
        if [[ "$min" != "-" && -n "$ver" ]] && ! agency_version_gte "$ver" "$min"; then
            OUTDATED=$((OUTDATED + 1))
            printf "  ${RED}✗${NC} %-20s %s\n" "$name" "$ver is below the $min floor ($path)"
            if [[ "$DEPS_OS" == "linux" && "$floor" != "-" ]]; then
                FLOORS+=("$floor:$min")
            else
                MISSING_MANUAL+=("$name (upgrade to >= $min)")
            fi
            continue
        fi

        printf "  ${GREEN}✓${NC} %-20s %s\n" "$name" "${ver:-installed}"
        FOUND=$((FOUND + 1))
    done <<< "$entries"
}

_run_checks() {
    MISSING_PKGS=(); MISSING_MANUAL=(); FLOORS=()
    FOUND=0; MISSING=0; OUTDATED=0; SKIPPED=0; TOTAL=0
    if [[ "$DEPS_TIER" == "all" || "$DEPS_TIER" == "required" ]]; then
        _check_tier "required" "Required"
    fi
    if [[ "$DEPS_TIER" == "all" || "$DEPS_TIER" == "testing" ]]; then
        _check_tier "testing" "Testing"
    fi
    if [[ "$DEPS_TIER" == "all" || "$DEPS_TIER" == "optional" ]]; then
        _check_tier "optional" "Optional"
    fi
    echo ""
    echo "────────────────────────────────────────"
    printf "  Total: %d | Found: %d | Missing: %d | Too old: %d | Skipped: %d\n" \
        "$TOTAL" "$FOUND" "$MISSING" "$OUTDATED" "$SKIPPED"
}

_wsl_notes() {
    [[ "$DEPS_PLATFORM" == "wsl" ]] || return 0
    if agency_is_windows_mount "$PROJECT_ROOT"; then
        echo ""
        echo -e "  ${YELLOW}WSL:${NC} this repo is on a Windows drive ($PROJECT_ROOT)."
        echo "       It works, but git is slow there and chmod is ignored unless the"
        echo "       drive is mounted with 'metadata'. A clone under ~/ is faster."
        echo "       See agency/REFERENCE/REFERENCE-WSL-UBUNTU.md."
    fi
}

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  Agency Dependency Check ($DEPS_PLATFORM)"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

_run_checks

if [[ $((MISSING + OUTDATED)) -eq 0 ]]; then
    echo -e "  ${GREEN}All dependencies satisfied.${NC}"
    _wsl_notes
    echo ""
    exit 0
fi

echo ""

_print_manual() {
    if [[ ${#MISSING_MANUAL[@]} -gt 0 ]]; then
        echo -e "${YELLOW}Manual install needed:${NC}"
        local name
        for name in "${MISSING_MANUAL[@]}"; do
            echo "  - $name (see dependencies.yaml for install instructions)"
        done
    fi
}

# --- Install missing ---

if [[ "$DEPS_CMD" == "install" ]]; then
    case "$DEPS_OS" in
        darwin)
            if ! command -v brew &>/dev/null; then
                echo -e "${RED}Homebrew not found.${NC} Install it first:"
                echo '  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"'
                exit 1
            fi
            if [[ ${#MISSING_PKGS[@]} -gt 0 ]]; then
                echo -e "Installing via brew: ${MISSING_PKGS[*]}"
                brew install "${MISSING_PKGS[@]}"
                echo ""
                echo -e "${GREEN}✓ Installed ${#MISSING_PKGS[@]} package(s).${NC}"
            fi
            ;;
        linux)
            # shellcheck source=/dev/null
            source "$AGENCY_DIR/tools/lib/_linux-floors"
            if [[ ${#MISSING_PKGS[@]} -gt 0 ]]; then
                if command -v apt-get &>/dev/null; then
                    echo -e "Installing via apt: ${MISSING_PKGS[*]}"
                    _linux_sudo apt-get install -y "${MISSING_PKGS[@]}"
                else
                    echo -e "${YELLOW}No apt on this system.${NC} Install with your package manager:"
                    echo "  ${MISSING_PKGS[*]}"
                fi
            fi
            if [[ ${#FLOORS[@]} -gt 0 ]]; then
                for entry in "${FLOORS[@]}"; do
                    case "${entry%%:*}" in
                        sqlite) linux_ensure_sqlite "${entry#*:}" || true ;;
                        python) linux_ensure_python "${entry#*:}" || true ;;
                    esac
                done
            fi
            ;;
        *)
            echo -e "${YELLOW}No installer for platform '$DEPS_PLATFORM'.${NC}"
            exit 1
            ;;
    esac

    # Re-check so the exit code reflects what is actually on PATH now.
    hash -r 2>/dev/null || true
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "  After install"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    _run_checks
    echo ""
    _print_manual
    if [[ $((MISSING + OUTDATED)) -eq 0 ]]; then
        echo -e "  ${GREEN}All dependencies satisfied.${NC}"
    fi
else
    if [[ ${#MISSING_PKGS[@]} -gt 0 || ${#FLOORS[@]} -gt 0 ]]; then
        echo "  Install missing: agency deps install"
    fi
    if [[ ${#MISSING_PKGS[@]} -gt 0 ]]; then
        if [[ "$DEPS_OS" == "linux" ]]; then
            echo "  Or manually:     sudo apt-get install -y ${MISSING_PKGS[*]}"
        else
            echo "  Or manually:     brew install ${MISSING_PKGS[*]}"
        fi
    fi
    _print_manual
fi

_wsl_notes
echo ""
exit $((MISSING + OUTDATED))
