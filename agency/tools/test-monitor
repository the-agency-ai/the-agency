if sys.version_info < (3, 13):
    print(
        f"[TEST ERROR] Python 3.13+ required (got "
        f"{sys.version_info.major}.{sys.version_info.minor}) — agent: "
        "install python3.13 or configure PATH",
        flush=True,
    )
    sys.exit(2)

import argparse
