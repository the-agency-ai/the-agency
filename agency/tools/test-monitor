import time
from pathlib import Path


# ── Tool metadata ────────────────────────────────────────────────────────────
TOOL_VERSION = "1.0.0-iter1-20260422"
TOOL_NAME = "test-monitor"


# ── Path resolution ──────────────────────────────────────────────────────────
SCRIPT_DIR = Path(__file__).resolve().parent
# Add agency/tools/lib to sys.path for test_parsers import (A&D §5.2)
sys.path.insert(0, str(SCRIPT_DIR / "lib"))

from test_parsers import (  # noqa: E402
    Event,
