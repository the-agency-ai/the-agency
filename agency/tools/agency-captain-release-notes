#!/bin/bash
#
# agency-captain-release-notes — Generate a captain-to-captain release notes
# skeleton covering a window of PRs landed on the repo's default branch.
#
# What Problem: When multiple captains (or captain + principal) work on the same
# monofolk-style repo, there's no standing convention for "here's what I shipped
# since the last sync" — the knowledge lives in git log + release tags + private
# handoffs. Cross-agent visibility into what landed (and what's in-flight)
# requires manually walking `gh release list`, `gh pr list`, correlating by date,
# assembling a markdown file with PR table + qualitative context. This is
# repetitive, error-prone, and tends to drift.
#
# Captured 2026-04-23 when principal asked captain to write a release-notes file
# for cross-captain coord: "this is a way to tell [other captain] what we have
# done." Manual authoring took ~15 minutes. Second round ("extend for all of
# yesterday") required re-walking the window. Principal then asked for a tool +
# skill so this becomes a single command.
#
# How & Why: Mechanical parts (PR enumeration, release window, filename,
# frontmatter) are tool-generated. Qualitative parts (TL;DR, shared-package
# changes, behavioral changes, open flags, in-flight) are placeholder sections
# the captain fills in after the skeleton lands. Keeps the captain's synthesis
# time focused on what only they can write — the narrative + coordination asks.
#
# Bash (not Python) because it is a thin orchestration layer over `gh` + `jq`
# with no data structures of its own, and it must run in any adopter repo with
# zero install. Bash 3.2 compatible (macOS default) — no associative arrays,
# no `mapfile`, no `${var,,}`.
#
# Scope: GENERATE the skeleton to a file (or stdout). Does not commit. Does
# not dispatch. Does not push. The captain reviews, fills qualitative sections,
# commits via /coord-commit, pushes via standard PR flow (or leaves as coord
# artifact on the default branch if that's the convention).
#
# Window detection order:
#   1. Explicit --start-version / --end-version (highest priority)
#   2. --start-date / --end-date (UTC timestamps)
#   3. Auto-detect: start = end_version of most recent prior release-notes file
#      in the release-notes/ directory; end = latest release on the repo
#
# Output path convention:
#   agency/workstreams/{workstream}/release-notes/release-notes-{YYYYMMDD}-{captain-name}-{vStart}-{vEnd}.md
#
# Audience convention:
#   Default audience is "any captain or principal working on {project}".
#   --to <addr> narrows to a specific agent (e.g. <repo>/<principal>/captain).
#
# Written: 2026-04-23 — convention-capture from monofolk v3.3-v3.31 release
# notes burst.
# Updated: 2026-08-12 — revived from stale PR #426 onto v46.33. Fixes:
#   - agent-identity: dropped the non-existent `--agent-address` flag; the tool
#     now reads the bare address (and --principal/--agent) that agent-identity
#     actually exposes. The old call silently produced "unknown-captain".
#   - `gh` resolution: prefers the framework wrapper agency/tools/gh (token
#     injection + telemetry) over bare `gh` on PATH.
#   - `jq` is now a declared preflight dependency instead of an implicit one
#     (`|| echo 0` used to mask its absence as "0 PRs in window").
#   - PR enumeration is scoped to the repo's default branch via
#     resolve-default-branch instead of every base branch in the repo.
#   - Latest release is selected via `isLatest` rather than trusting list order.
#   - Workstream default: project.name is a free-text field ("My Project" in the
#     shipped agency.yaml), so it is now slugified and probed against
#     agency/workstreams/ with repo-name and "agency" fallbacks.
#   - Colors: lib/_colors exports unescaped \033 sequences, so all output moved
#     from `echo` to `printf '%b'` (previously printed literal "\033[0;31m").
#   - PR titles containing `|` are escaped so they cannot break the table.
#   - Prior-window detection sorts release-notes files lexically (filenames are
#     date-stamped) instead of by mtime, which a checkout reshuffles.
#   - An explicit --captain now drives the frontmatter `from:` address too. It
#     used to name one captain in the header and a different one in `from:`.
#   - `from:` no longer rebuilt the address by replacing the FIRST hyphen in the
#     captain name, which mangled multi-word principals ("jordan-of-captain"
#     became "jordan/of-captain"). Splits on the last hyphen now.

set -euo pipefail

TOOL_VERSION="1.1.0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ -n "${CLAUDE_PROJECT_DIR:-}" ]]; then
    PROJECT_ROOT="$CLAUDE_PROJECT_DIR"
elif PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    :
else
    PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
fi

# --- Colors ---
# lib/_colors exports sequences with unescaped \033, so every consumer must
# render them with printf '%b' (or echo -e). Plain `echo` prints them literally.
if [[ -f "$SCRIPT_DIR/lib/_colors" ]]; then
    # shellcheck source=lib/_colors
    source "$SCRIPT_DIR/lib/_colors"
else
    RED='\033[0;31m' GREEN='\033[0;32m' YELLOW='\033[1;33m' BLUE='\033[0;34m' NC='\033[0m'
fi
: "${YELLOW:=}"

say()  { printf '%b\n' "$*"; }
die()  { printf '%b\n' "${RED}[ERROR]${NC} $1" >&2; exit 1; }
info() { printf '%b\n' "${BLUE}[INFO]${NC} $1" >&2; }
warn() { printf '%b\n' "${YELLOW}[WARN]${NC} $1" >&2; }

# --- Args ---
START_VERSION=""
END_VERSION=""
START_DATE=""
END_DATE=""
TO_ADDR=""
AUDIENCE=""
WORKSTREAM=""
OUTPUT_FILE=""
STDOUT_MODE=false
DRY_RUN=false
CAPTAIN_NAME=""
CAPTAIN_ADDR=""
PROJECT_NAME=""
BASE_BRANCH=""
PR_LIMIT=200

usage() {
    cat <<'USAGE'
agency-captain-release-notes — Generate captain-to-captain release notes skeleton

Usage:
  agency-captain-release-notes [options]

Options:
  --start-version <vX.Y>   Starting release tag (exclusive — the last one
                           already covered by a prior release notes file).
                           Auto-detected from most recent prior file if omitted.
  --end-version <vX.Y>     Ending release tag (inclusive — the most recent
                           release you want covered). Auto-detected from the
                           repo's latest release if omitted.
  --start-date <ISO>       Alternative to --start-version. UTC timestamp
                           (YYYY-MM-DDTHH:MM:SSZ).
  --end-date <ISO>         Alternative to --end-version.
  --base <branch|all>      Base branch for PR enumeration. Default: the repo's
                           default branch (resolve-default-branch). Use "all"
                           to count PRs merged into any base.
  --limit <n>              Max PRs to scan (default 200).
  --to <address>           Specific addressee (e.g. "<repo>/<principal>/captain").
                           Default: broadcast (audience-only frontmatter).
  --audience <string>      Human-readable audience description. Default:
                           "any captain or principal working on <project>".
  --workstream <name>      Workstream directory under agency/workstreams/.
                           Default: resolved from agency.yaml project name,
                           falling back to the repo name, then "agency".
  --captain <name>         Captain name for filename + frontmatter (e.g.
                           "jordan-captain"). Default: resolved from
                           agency/tools/agent-identity.
  --output <path>          Explicit output file path. Default:
                           agency/workstreams/<workstream>/release-notes/
                           release-notes-<YYYYMMDD>-<captain>-<vStart>-<vEnd>.md
  --stdout                 Print to stdout instead of writing a file.
  --dry-run                Show what would be written without writing.
  --help, -h               Show this help.
  --version                Show tool version.

Examples:
  # Simplest invocation — auto-detect everything
  agency-captain-release-notes

  # Specify window explicitly
  agency-captain-release-notes --start-version v46.13 --end-version v46.33

  # Address to a specific captain (narrows audience)
  agency-captain-release-notes --to acme/peter/captain

  # Preview without writing
  agency-captain-release-notes --dry-run

  # Print to stdout (for piping / review)
  agency-captain-release-notes --stdout
USAGE
    exit 0
}

require_value() {
    # $1 = flag name, $2 = count of remaining args
    [[ "$2" -ge 2 ]] || die "$1 requires a value (see --help)"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --start-version)  require_value "$1" $#; START_VERSION="$2"; shift 2;;
        --end-version)    require_value "$1" $#; END_VERSION="$2"; shift 2;;
        --start-date)     require_value "$1" $#; START_DATE="$2"; shift 2;;
        --end-date)       require_value "$1" $#; END_DATE="$2"; shift 2;;
        --base)           require_value "$1" $#; BASE_BRANCH="$2"; shift 2;;
        --limit)          require_value "$1" $#; PR_LIMIT="$2"; shift 2;;
        --to)             require_value "$1" $#; TO_ADDR="$2"; shift 2;;
        --audience)       require_value "$1" $#; AUDIENCE="$2"; shift 2;;
        --workstream)     require_value "$1" $#; WORKSTREAM="$2"; shift 2;;
        --captain)        require_value "$1" $#; CAPTAIN_NAME="$2"; shift 2;;
        --output)         require_value "$1" $#; OUTPUT_FILE="$2"; shift 2;;
        --stdout)         STDOUT_MODE=true; shift;;
        --dry-run)        DRY_RUN=true; shift;;
        --help|-h)        usage;;
        --version)        echo "agency-captain-release-notes $TOOL_VERSION"; exit 0;;
        *)                die "Unknown argument: $1 (see --help)";;
    esac
done

[[ "$PR_LIMIT" =~ ^[0-9]+$ ]] || die "--limit must be a positive integer (got: $PR_LIMIT)"

# --- Preflight: gh + jq ---
# Prefer the framework gh wrapper (token injection + telemetry) when present.
# Fall back to bare gh so the tool still works in a non-Agency checkout.
if [[ -x "$PROJECT_ROOT/agency/tools/gh" ]]; then
    GH="$PROJECT_ROOT/agency/tools/gh"
elif command -v gh >/dev/null 2>&1; then
    GH="gh"
else
    die "gh CLI not found. Install via https://cli.github.com/"
fi
command -v jq >/dev/null 2>&1 || die "jq not found. Install via https://jqlang.github.io/jq/"

# --- Auto-detect: project name (from agency.yaml) ---
AGENCY_YAML="$PROJECT_ROOT/agency/config/agency.yaml"
if [[ -f "$AGENCY_YAML" ]]; then
    # Very narrow yaml parse: look for "  name:" under the "project:" block.
    # Avoid requiring a yaml library (stdlib-only / zero-pip policy).
    PROJECT_NAME=$(awk '
        /^project:/ { in_project=1; next }
        /^[a-zA-Z]/ && !/^project:/ { in_project=0 }
        in_project && /^  name:/ { gsub(/.*name: *"?/, ""); gsub(/".*$/, ""); gsub(/[ \t]+$/, ""); print; exit }
    ' "$AGENCY_YAML")
fi

# --- Auto-detect: agent identity ---
# agent-identity prints the fully qualified address "<repo>/<principal>/<agent>"
# on stdout with no flags; --principal / --agent / --repo print components.
# (The pre-revival code called a --agent-address flag that has never existed,
# which meant CAPTAIN_NAME silently degraded to "unknown-captain".)
IDENT_REPO=""
IDENT_PRINCIPAL=""
IDENT_AGENT=""
if [[ -x "$PROJECT_ROOT/agency/tools/agent-identity" ]]; then
    AGENT_ADDR=$("$PROJECT_ROOT/agency/tools/agent-identity" 2>/dev/null || true)
    if [[ "$AGENT_ADDR" == */*/* ]]; then
        IFS='/' read -r IDENT_REPO IDENT_PRINCIPAL IDENT_AGENT <<< "$AGENT_ADDR"
    fi
fi

PROJECT_NAME="${PROJECT_NAME:-${IDENT_REPO:-unknown-project}}"

slugify() {
    # Lowercase, spaces/underscores → dashes, drop everything else.
    # bash 3.2: no ${var,,}, so tr does the lowering.
    printf '%s' "$1" \
        | tr '[:upper:]' '[:lower:]' \
        | sed -e 's/[ _]\{1,\}/-/g' -e 's/[^a-z0-9.-]//g' -e 's/^-*//' -e 's/-*$//'
}

PROJECT_SLUG="$(slugify "$PROJECT_NAME")"
PROJECT_SLUG="${PROJECT_SLUG:-unknown-project}"

# --- Default workstream ---
# project.name is free text ("My Project" ships in the default agency.yaml), so
# it is not directly usable as a directory name. Probe slugified candidates
# against agency/workstreams/ and take the first that exists.
if [[ -z "$WORKSTREAM" ]]; then
    for candidate in "$PROJECT_SLUG" "$(slugify "${IDENT_REPO:-}")" "agency"; do
        [[ -n "$candidate" ]] || continue
        if [[ -d "$PROJECT_ROOT/agency/workstreams/$candidate" ]]; then
            WORKSTREAM="$candidate"
            break
        fi
    done
fi
WORKSTREAM="${WORKSTREAM:-$PROJECT_SLUG}"

# --- Captain name / address ---
# An explicit --captain must also drive the `from:` address, or the note claims
# one identity in its header and a different one in its frontmatter.
if [[ -n "$CAPTAIN_NAME" ]]; then
    # Split on the LAST hyphen: "jordan-captain" → jordan/captain, and a
    # multi-word principal like "jordan-of-captain" → jordan-of/captain.
    _cap_agent="${CAPTAIN_NAME##*-}"
    _cap_principal="${CAPTAIN_NAME%-*}"
    if [[ "$_cap_principal" == "$CAPTAIN_NAME" || -z "$_cap_principal" ]]; then
        # No hyphen — treat the whole name as the agent under the known principal.
        _cap_principal="${IDENT_PRINCIPAL:-unknown}"
        _cap_agent="$CAPTAIN_NAME"
    fi
    CAPTAIN_ADDR="${IDENT_REPO:-$PROJECT_SLUG}/${_cap_principal}/${_cap_agent}"
elif [[ -n "$IDENT_PRINCIPAL" && -n "$IDENT_AGENT" ]]; then
    CAPTAIN_NAME="${IDENT_PRINCIPAL}-${IDENT_AGENT}"
    CAPTAIN_ADDR="${IDENT_REPO:-$PROJECT_SLUG}/${IDENT_PRINCIPAL}/${IDENT_AGENT}"
else
    CAPTAIN_NAME="unknown-captain"
    CAPTAIN_ADDR="${PROJECT_SLUG}/unknown/captain"
fi

# --- Default audience ---
AUDIENCE="${AUDIENCE:-any captain or principal working on $PROJECT_NAME}"

# --- Base branch for PR enumeration ---
if [[ -z "$BASE_BRANCH" ]]; then
    if [[ -x "$PROJECT_ROOT/agency/tools/resolve-default-branch" ]]; then
        BASE_BRANCH="$("$PROJECT_ROOT/agency/tools/resolve-default-branch" -C "$PROJECT_ROOT" 2>/dev/null || true)"
    fi
    BASE_BRANCH="${BASE_BRANCH:-all}"
fi

# --- Window detection ---
DATE_TODAY="$(date -u +%Y%m%d)"

utc_days_ago() {
    # BSD date (macOS) and GNU date disagree on relative-date syntax.
    local days="$1"
    date -u -v-"${days}"d +%Y-%m-%dT%H:%M:%SZ 2>/dev/null \
        || date -u -d "${days} days ago" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null \
        || echo "1970-01-01T00:00:00Z"
}

# Single releases fetch — reused for end-version detection and both date bounds.
RELEASES_JSON=$("$GH" release list --limit "$PR_LIMIT" --json tagName,publishedAt,isLatest 2>/dev/null || echo '[]')
echo "$RELEASES_JSON" | jq -e 'type == "array"' >/dev/null 2>&1 || RELEASES_JSON='[]'

release_published_at() {
    echo "$RELEASES_JSON" | jq -r --arg t "$1" '.[] | select(.tagName == $t) | .publishedAt' 2>/dev/null | head -1
}

# end-version: if not given, use the repo's latest release.
# Do not trust list order — select on isLatest, then fall back to first entry.
if [[ -z "$END_VERSION" ]]; then
    END_VERSION=$(echo "$RELEASES_JSON" | jq -r 'map(select(.isLatest)) | .[0].tagName // ""')
    [[ -z "$END_VERSION" ]] && END_VERSION=$(echo "$RELEASES_JSON" | jq -r '.[0].tagName // ""')
    [[ -z "$END_VERSION" ]] && die "--end-version not given and could not auto-detect (no releases found)"
fi

# start-version: if not given, look in release-notes/ for the most recent file
# and pull its `end_version` frontmatter value.
RELEASE_NOTES_DIR="$PROJECT_ROOT/agency/workstreams/$WORKSTREAM/release-notes"
if [[ -z "$START_VERSION" && -d "$RELEASE_NOTES_DIR" ]]; then
    # Filenames are date-stamped (release-notes-YYYYMMDD-...), so a lexical
    # sort is stable across checkouts in a way mtime ordering is not.
    PREV_FILE=$(ls -1 "$RELEASE_NOTES_DIR"/*.md 2>/dev/null | sort | tail -1 || true)
    if [[ -n "$PREV_FILE" ]]; then
        PREV_END=$(awk '
            /^---/ && !fm { fm=1; next }
            /^---/ && fm { exit }
            fm && /^ *end_version:/ { sub(/.*end_version:[ \t]*/, ""); print; exit }
        ' "$PREV_FILE")
        [[ -n "$PREV_END" ]] && START_VERSION="$PREV_END"
    fi
fi
START_VERSION="${START_VERSION:-v0.0}"

# --- Date bounds ---
if [[ -z "$START_DATE" ]]; then
    START_DATE="$(release_published_at "$START_VERSION")"
    [[ -z "$START_DATE" ]] && START_DATE="$(utc_days_ago 30)"
fi

if [[ -z "$END_DATE" ]]; then
    END_DATE="$(release_published_at "$END_VERSION")"
    END_DATE="${END_DATE:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}"
fi

info "Window: $START_VERSION ($START_DATE) → $END_VERSION ($END_DATE)"
info "Project: $PROJECT_NAME | Workstream: $WORKSTREAM | Captain: $CAPTAIN_NAME | Base: $BASE_BRANCH"

# --- Enumerate merged PRs in window ---
# Scoped to the repo's default branch by default: on a fleet repo, PRs merged
# into agent branches are not "what shipped", and counting them inflates the
# window. `--base all` restores the old count-everything behavior.
PR_ARGS="--state merged --limit $PR_LIMIT --json number,title,mergedAt,author"
if [[ "$BASE_BRANCH" != "all" ]]; then
    PR_ARGS="$PR_ARGS --base $BASE_BRANCH"
fi

# shellcheck disable=SC2086
PRS_RAW=$("$GH" pr list $PR_ARGS 2>/dev/null || echo '[]')
echo "$PRS_RAW" | jq -e 'type == "array"' >/dev/null 2>&1 || PRS_RAW='[]'

PRS_JSON=$(echo "$PRS_RAW" | jq --arg s "$START_DATE" --arg e "$END_DATE" \
    '[.[] | select(.mergedAt != null and .mergedAt > $s and .mergedAt <= $e)] | sort_by(.mergedAt)')

PR_COUNT=$(echo "$PRS_JSON" | jq 'length')
info "Found $PR_COUNT PRs in window"
[[ "$PR_COUNT" == "0" ]] && warn "No PRs matched — check --base / --start-date / --end-date."

# --- Render PRs table ---
render_pr_table() {
    echo "| PR | Merged (UTC) | Author | Title |"
    echo "| --- | --- | --- | --- |"
    if [[ "$PR_COUNT" == "0" ]]; then
        echo "| — | — | — | _no merged PRs in window_ |"
        return
    fi
    # Escape pipes in titles so a title can never break the table.
    echo "$PRS_JSON" | jq -r '
        .[] | "| #\(.number) | \(.mergedAt) | \(.author.login // "unknown") | \(.title | gsub("\\|"; "\\|")) |"
    '
}

# --- Render frontmatter ---
render_frontmatter() {
    echo "---"
    echo "type: release-notes"
    echo "from: $CAPTAIN_ADDR"
    if [[ -n "$TO_ADDR" ]]; then
        echo "to: $TO_ADDR"
    fi
    echo "audience: $AUDIENCE"
    echo "date: $(date -u +%Y-%m-%d)"
    echo "window:"
    echo "  start_version: $START_VERSION"
    echo "  end_version: $END_VERSION"
    echo "  base_branch: $BASE_BRANCH"
    echo "  wall_clock_start: $START_DATE"
    echo "  wall_clock_end: $END_DATE"
    echo "prs_landed_count: $PR_COUNT"
    echo "generated_by: agency-captain-release-notes v$TOOL_VERSION"
    echo "---"
}

# --- Render skeleton body ---
render_body() {
    cat <<BODY

# Release Notes — $PROJECT_NAME $START_VERSION through $END_VERSION

**From:** $CAPTAIN_NAME ($CAPTAIN_ADDR)
**Audience:** $AUDIENCE
BODY
    if [[ -n "$TO_ADDR" ]]; then
        echo "**Addressed to:** $TO_ADDR"
    fi
    cat <<BODY
**Window:** $START_DATE through $END_DATE ($PR_COUNT PRs merged into \`$BASE_BRANCH\`)

---

## TL;DR

<!-- Fill in: one-paragraph executive summary of what shipped this window. -->

---

## PRs landed

$(render_pr_table)

---

## Cross-repo / shared-package changes

<!-- Fill in: new or changed shared paths (packages/*, tools/*, config/*)
     that other captains' agents may consume downstream. If any of their
     branches pull these, a merge-from-master will pick them up. -->

---

## Master behavioral changes

<!-- Fill in: things downstream branches need to pick up on next merge.
     - Process changes (conventions, receipt patterns)
     - Infrastructure (monitors, CI, build)
     - Tool / skill landings that affect how agents work -->

---

## Open items / flags

<!-- Fill in: anything another captain touching these surfaces should know.
     - Framework flags filed during this window
     - Known issues + workarounds
     - Upstream issues filed (the-agency# / adapter#) -->

---

## In-flight (not yet PR'd)

<!-- Fill in: things accumulating in worktrees as of publish time — so
     other captains/principals can avoid duplication or collision.
     Organize by workstream. -->

---

## Coordination requests

<!-- Fill in: any asks / questions for other captains. Keep it to things
     that would genuinely benefit from their input. -->

---

— $CAPTAIN_NAME
_generated by \`agency-captain-release-notes\` v${TOOL_VERSION}_

BODY
}

# --- Determine output path ---
if [[ "$STDOUT_MODE" != "true" && -z "$OUTPUT_FILE" ]]; then
    OUTPUT_FILE="$RELEASE_NOTES_DIR/release-notes-${DATE_TODAY}-${CAPTAIN_NAME}-${START_VERSION}-${END_VERSION}.md"
fi

# --- Dry run: just report ---
if [[ "$DRY_RUN" == "true" ]]; then
    info "DRY RUN — would write to: ${OUTPUT_FILE:-<stdout>}"
    info "  frontmatter fields: from/audience/to/window/prs_landed_count"
    info "  PR rows: $PR_COUNT"
    exit 0
fi

# --- Write output ---
if [[ "$STDOUT_MODE" == "true" ]]; then
    render_frontmatter
    render_body
else
    mkdir -p "$(dirname "$OUTPUT_FILE")"
    {
        render_frontmatter
        render_body
    } > "$OUTPUT_FILE"

    say "${GREEN}✓${NC} Release notes skeleton written: $OUTPUT_FILE"
    echo ""
    echo "Next steps:"
    echo "  1. Fill qualitative sections (TL;DR, shared-package changes, flags, in-flight, coordination)."
    echo "  2. Commit via /coord-commit (coord artifact — no QG gate)."
    echo "  3. (Optional) Dispatch a pointer to specific agents if narrow addressing is needed."
fi
